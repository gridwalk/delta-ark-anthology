<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Delta Ark Anthology{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Noto+Sans+SC:wght@100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/main.css">
  {% if page == 'toc' %}
    {# three's postprocessing modules import the bare specifier "three".
       Must precede any module script for the mapping to apply. #}
    <script type="importmap">
      { "imports": { "three": "/static/js/vendor/three.module.min.js" } }
    </script>
  {% endif %}
  {% block head %}{% endblock %}
</head>
<body class="{% block bodyClass %}{% endblock %}">

  {% if page == 'toc' %}
    <canvas id="scene" class="scene-backdrop" data-count="{{ artists | length }}" aria-hidden="true"></canvas>
  {% endif %}

  <header class="site-header">
    <nav class="site-nav">
      <a href="/" class="nav-home">Delta Ark Anthology</a>
    </nav>
  </header>

  <main>
    {% block content %}{% endblock %}
  </main>

  <script src="/static/js/main.js"></script>
  {% if page == 'toc' %}
    <script type="module" src="/static/js/scene.js"></script>
  {% endif %}
  {% block scripts %}{% endblock %}
</body>
</html>
