<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Delta Ark Anthology{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Martian+Mono:wdth,wght@75..112.5,100..800&family=Noto+Sans+SC:wght@100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/main.css">
  {% if page == 'toc-lattice' %}
    {# three's line modules import the bare specifier "three".
       Must precede any module script for the mapping to apply. #}
    <script type="importmap">
      { "imports": { "three": "/static/js/vendor/three.module.min.js" } }
    </script>
  {% endif %}
  {% block head %}{% endblock %}
</head>
<body class="{% block bodyClass %}{% endblock %}">

  {% if page == 'toc-lattice' %}
    <canvas id="scene" class="scene-backdrop" data-count="{{ artists | length }}" aria-hidden="true"></canvas>
  {% endif %}

  {% if page == 'toc' or page == 'about' or page == 'artist' %}
    {# The ship is a self-contained WebGPU build with its own render loop, so
       it is framed rather than imported. pointer-events are disabled in CSS so
       its OrbitControls never swallow clicks meant for the listing above.
       On the homepage, ?groups= sets aside one group of buildings per listing
       entry, which ship-highlight.js lights on hover. On the about and artist
       pages, ?ship=0 leaves the sea alone, with no ship. #}
    <iframe
      class="ship-backdrop"
      src="{% if page == 'toc' %}/ship/?groups={{ artists | length }}{% else %}/ship/?ship=0{% endif %}"
      title="{% if page == 'toc' %}Arcology ship{% else %}Open sea{% endif %}"
      tabindex="-1"
      aria-hidden="true"
      loading="lazy"
    ></iframe>
  {% endif %}

  {# The homepage replaces this with a title cell in the listing itself. #}
  {% block header %}
  <header class="site-header">
    <nav class="site-nav">
      <a href="/" class="nav-home">Delta Ark Anthology</a>
    </nav>
  </header>
  {% endblock %}

  <main>
    {% block content %}{% endblock %}
  </main>

  <script src="/static/js/main.js"></script>
  {% if page == 'toc-lattice' %}
    <script type="module" src="/static/js/scene.js"></script>
  {% endif %}
  {% block scripts %}{% endblock %}
</body>
</html>
