{% extends "base.njk" %}

{% block title %}{{ artist.name }} &mdash; Delta Ark Anthology{% endblock %}

{% block bodyClass %}artist-page{% endblock %}

{% block content %}
{% set hasMedia = artist.video_url or artist.featured_image %}

<article class="artist{% if hasMedia %} has-media{% endif %}">

  <div class="artist-main panel-stack">

    <header class="panel artist-header">
      <h1 class="artist-name">{{ artist.name }}</h1>

      {% if artist.country or artist.medium or artist.year %}
        <dl class="artist-meta">
          {% if artist.country %}
            <dt>Country</dt>
            <dd>{{ artist.country }}</dd>
          {% endif %}
          {% if artist.medium %}
            <dt>Medium</dt>
            <dd>{{ artist.medium }}</dd>
          {% endif %}
          {% if artist.year %}
            <dt>Year</dt>
            <dd>{{ artist.year }}</dd>
          {% endif %}
        </dl>
      {% endif %}
    </header>

    {% if artist.work_title %}
      <div class="panel artist-work">
        <h2 class="artist-work-title">{{ artist.work_title }}</h2>
      </div>
    {% endif %}

    <div class="panel artist-body">
      {{ artist.body | safe }}
    </div>

    {% if artist.essay_url %}
      <div class="panel artist-essay-link">
        <a href="{{ artist.essay_url }}" target="_blank" rel="noopener">Read Essay &rarr;</a>
      </div>
    {% endif %}

  </div>

  {% if hasMedia %}
    <aside class="artist-aside panel-stack">

      {% if artist.video_url %}
        <div class="panel artist-video">
          <div class="artist-video-frame">
            <iframe
              src="{{ artist.video_url }}"
              width="100%"
              height="480"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      {% endif %}

      {% if artist.featured_image %}
        <figure class="panel artist-featured-image">
          <span class="panel-label">Plate</span>
          <img src="{{ artist.featured_image }}" alt="{{ artist.name }}">
        </figure>
      {% endif %}

    </aside>
  {% endif %}

</article>
{% endblock %}
