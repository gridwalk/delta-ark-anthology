{% extends "base.njk" %}

{# With `selected`, this is an artist URL: the same page, with the listing
   already collapsed (see buildArtistPages in build.js). #}
{# With `about`, this is the about URL: the listing collapsed, with the about
   text open in the text panel. #}
{% block title %}{% if selected %}{{ selected.name }}{% elif about %}About{% else %}Table of Contents{% endif %} &mdash; Runtime Season{% endblock %}

{% block bodyClass %}toc-page toc-ship{% endblock %}

{# No header: the title sits in the listing's first column instead. #}
{% block header %}{% endblock %}

{# The listing runs in 3, 2, or 1 columns by screen width (the breakpoints
   are in main.css). At each count all columns end on the same row: the rows
   are the fewest that fit every entry plus a title of at least titleMinRows,
   and the title spans whatever rows the entries leave spare. The counts for
   each layout go to the stylesheet as --toc-lines-N and --toc-title-rows-N.
   With 22 entries and titleMinRows 2: 8, 12, or 24 rows, and a 2-row title
   in each. #}
{% set titleMinRows = 2 %}
{% set entries = artists | length %}
{% set rows3 = ((entries + titleMinRows) / 3) | round(0, "ceil") %}
{% set rows2 = ((entries + titleMinRows) / 2) | round(0, "ceil") %}
{% set rows1 = entries + titleMinRows %}

{% block content %}
<section class="toc" style="--toc-lines-3: {{ rows3 }}; --toc-title-rows-3: {{ rows3 * 3 - entries }}; --toc-lines-2: {{ rows2 }}; --toc-title-rows-2: {{ rows2 * 2 - entries }}; --toc-lines-1: {{ rows1 }}; --toc-title-rows-1: {{ rows1 - entries }}">
  {% include "_toc-list.njk" %}

  {# The artwork information, one block for each artist, all hidden until an
     artist is chosen (see page-nav.js). The panel sits in the first listing
     column, directly under the title box. On an artist URL, that artist's
     block starts in view. #}
  <div class="artwork-panel"{% if not (selected or about) %} hidden{% endif %}>
    {# The about text. Placeholder copy until the real text is written. It
       has no media and no laser (see openAbout in page-nav.js). #}
    <article class="artwork-info" data-slug="about"{% if not about %} hidden{% endif %}>
      <h2 class="headline artwork-title">About</h2>
      <div class="artist-body">
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
        <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
        <p>Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo. Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit.</p>
        <p>Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit, sed quia non numquam eius modi tempora incidunt ut labore et dolore magnam aliquam quaerat voluptatem. Ut enim ad minima veniam, quis nostrum exercitationem ullam corporis suscipit laboriosam.</p>
        <p>At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti atque corrupti quos dolores et quas molestias excepturi sint occaecati cupiditate non provident, similique sunt in culpa qui officia deserunt mollitia animi, id est laborum et dolorum fuga.</p>
        <p>Nam libero tempore, cum soluta nobis est eligendi optio cumque nihil impedit quo minus id quod maxime placeat facere possimus, omnis voluptas assumenda est, omnis dolor repellendus. Temporibus autem quibusdam et aut officiis debitis aut rerum necessitatibus saepe eveniet.</p>
      </div>
      <p class="about-credit">Web design by <a href="https://donhanson.art" target="_blank" rel="noopener">Don Hanson</a></p>
    </article>
    {% for artist in artists %}
    <article class="artwork-info" data-slug="{{ artist.slug }}"{% if artist.video_url %} data-video="{{ artist.video_url }}"{% endif %}{% if artist.poster %} data-poster="{{ artist.poster }}"{% endif %}{% if not (selected and artist.slug == selected.slug) %} hidden{% endif %}>
      {# The work title as the headline, then the artist name under it in the
         body face. #}
      {% if artist.work_title %}<h2 class="headline artwork-title">{{ artist.work_title }}</h2>{% endif %}
      <p class="artwork-name">{{ artist.name }}</p>
      {% if artist.country or artist.medium or artist.year %}
      <p class="artwork-meta">{{ [artist.year, artist.country, artist.medium] | select | join(" · ") }}</p>
      {% endif %}
      <div class="artist-body">{{ artist.body | safe }}</div>
      {% if artist.essay_url %}
      <p class="artwork-essay"><a href="{{ artist.essay_url }}" target="_blank" rel="noopener">Read essay &rarr;</a></p>
      {% endif %}
    </article>
    {% endfor %}
  </div>

  {# The artwork's media on an artist view: the video embed, or else the
     poster. It is placed over the laser's end (see page-nav.js), and the
     embed only exists while it shows, so a video stops when it goes. #}
  <div class="artwork-media" hidden></div>

  {# Links to the previous and next artist in the listing's order, in the
     space under the media (see page-nav.js). #}
  <nav class="artwork-pager" aria-label="More artworks" hidden>
    <a href="/" class="pager-prev">Previous</a>
    <a href="/" class="pager-next">Next</a>
  </nav>

  {# A black-to-clear shade behind the text column on an artist view. It must
     come after the artwork panel: CSS shows it while the panel shows. #}
  <div class="artwork-shade" aria-hidden="true"></div>

  {# Frames for the ship's fixed front, side, and top views. They are empty:
     the ship iframe draws each view into the space inside its frame. #}
  {# On an artist URL the tiles start hidden (see page-nav.js). #}
  <div class="ship-panel-stack{% if selected or about %} is-hidden{% endif %}" aria-hidden="true">
    <div class="ship-panel"></div>
    <div class="ship-panel"></div>
    <div class="ship-panel"></div>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script src="/static/js/ship-highlight.js"></script>
<script src="/static/js/page-nav.js"></script>
{# TUNING: temporary dither and fog panel, shown with ?tune=1. #}
<script src="/static/js/ship-tune.js"></script>
{% endblock %}
